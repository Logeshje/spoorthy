<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#160d24">
  <title>Spoorthy's Permission Portal™</title>
  <style>
    :root {
      --bg:#10091b; --panel:#21132f; --panel2:#2b1940; --pink:#ff75b5;
      --yellow:#ffe66d; --mint:#83f5c5; --white:#fff8ff; --muted:#c9b7d5;
      --red:#ff647c; --line:rgba(255,255,255,.14);
    }
    * { box-sizing:border-box }
    body {
      margin:0; min-height:100vh; color:var(--white);
      font-family: ui-rounded, "Trebuchet MS", system-ui, sans-serif;
      background:
        radial-gradient(circle at 12% 12%, rgba(255,117,181,.20), transparent 28rem),
        radial-gradient(circle at 90% 80%, rgba(131,245,197,.13), transparent 25rem),
        var(--bg);
      overflow-x:hidden;
    }
    button { font:inherit; cursor:pointer }
    .wrap { width:min(760px, calc(100% - 28px)); margin:0 auto; padding:34px 0 48px }
    .topline { display:flex; justify-content:space-between; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:18px }
    .stamp,.pill { border:1px solid var(--line); border-radius:999px; padding:8px 12px; color:var(--muted); font-size:.78rem; letter-spacing:.04em }
    .stamp { color:var(--yellow); transform:rotate(-2deg); font-weight:900 }
    .hero { text-align:center; padding:26px 18px 22px }
    .emoji { font-size:clamp(3rem, 10vw, 5.5rem); line-height:1; filter:drop-shadow(0 8px 0 rgba(0,0,0,.18)); animation:bob 2.2s ease-in-out infinite }
    h1 { font-size:clamp(2rem, 8vw, 4.3rem); line-height:.98; margin:18px 0 12px; letter-spacing:-.06em }
    h1 span { color:var(--pink); text-shadow:3px 3px 0 #6b2854 }
    .subtitle { max-width:560px; margin:0 auto; color:var(--muted); font-size:1.02rem; line-height:1.6 }
    .card { background:linear-gradient(145deg,rgba(43,25,64,.97),rgba(28,17,42,.97)); border:1px solid var(--line); border-radius:26px; padding:clamp(20px,5vw,34px); box-shadow:0 22px 70px rgba(0,0,0,.28); position:relative; overflow:hidden }
    .card:before { content:""; position:absolute; width:170px; height:170px; border:1px dashed rgba(255,255,255,.10); border-radius:50%; right:-80px; top:-90px }
    .progressline { height:7px; border-radius:99px; background:rgba(255,255,255,.10); overflow:hidden; margin:0 0 24px }
    .progress { height:100%; width:50%; border-radius:99px; background:linear-gradient(90deg,var(--pink),var(--yellow)); transition:width .35s ease }
    .step { color:var(--mint); text-transform:uppercase; font-size:.75rem; letter-spacing:.14em; font-weight:900 }
    h2 { font-size:clamp(1.65rem,5vw,2.5rem); line-height:1.08; margin:12px 0 }
    .desc { color:var(--muted); line-height:1.55; margin:0 0 22px }
    .buttonzone { display:flex; flex-wrap:wrap; gap:12px; align-items:center; min-height:76px; position:relative }
    .choice { border:0; border-radius:15px; padding:14px 20px; min-width:145px; font-weight:1000; font-size:1rem; transition:transform .15s, filter .15s; box-shadow:0 6px 0 rgba(0,0,0,.22) }
    .choice:hover { filter:brightness(1.08); transform:translateY(-2px) }
    .yes { color:#24112b; background:var(--mint) }
    .no { color:#311222; background:var(--pink) }
    .tiny { color:var(--muted); font-size:.82rem; margin-top:16px }
    .reaction { min-height:28px; margin:14px 0 0; color:var(--yellow); font-weight:800; line-height:1.4 }
    .hidden { display:none !important }
    .result { text-align:center; padding:12px 0 4px }
    .result .big { font-size:4rem }
    .result h2 { margin:12px 0 }
    .result p { color:var(--muted); line-height:1.6 }
    .reset { background:transparent; border:1px solid var(--line); color:var(--white); padding:10px 14px; border-radius:12px; margin-top:12px }
    .footer { text-align:center; color:#8f7b9d; font-size:.75rem; margin:20px 0 0; line-height:1.6 }
    .toast { position:fixed; left:50%; bottom:18px; transform:translate(-50%,20px); opacity:0; pointer-events:none; background:#fff8ff; color:#21132f; padding:12px 18px; border-radius:14px; font-weight:900; box-shadow:0 12px 35px #0008; transition:.25s; z-index:10; width:max-content; max-width:calc(100% - 28px); text-align:center }
    .toast.show { opacity:1; transform:translate(-50%,0) }
    .confetti { position:fixed; top:-20px; z-index:9; pointer-events:none; animation:fall linear forwards; font-size:22px }
    @keyframes bob { 0%,100%{transform:translateY(0) rotate(-3deg)} 50%{transform:translateY(-9px) rotate(3deg)} }
    @keyframes fall { to { transform:translateY(110vh) rotate(720deg); opacity:.2 } }
    @media(max-width:520px) { .wrap{padding-top:18px}.topline{justify-content:center}.buttonzone{flex-direction:column;align-items:stretch}.choice{width:100%} }
    @media(prefers-reduced-motion:reduce) { *,*:before,*:after{animation:none!important;transition:none!important} }
  </style>
</head>
<body>
  <main class="wrap">
    <div class="topline">
      <div class="stamp">OFFICIAL • VERY SERIOUS • 100% LEGIT</div>
      <div class="pill">CASE ID: LOGI-2026-001</div>
    </div>

    <header class="hero">
      <div class="emoji" aria-hidden="true">💀📢🗿</div>
      <h1>Spoorthy's <span>Permission</span> Portal™</h1>
      <p class="subtitle">BREAKING: Logesh has submitted two requests to the Department of Spoorthy Affairs. The internet is waiting. His survival instincts are 2%.</p>
    </header>

    <section class="card" aria-live="polite">
      <div class="progressline"><div class="progress" id="progress"></div></div>

      <div id="question1">
        <div class="step">Request 01 / 02 · Social life department</div>
        <h2>Can we go out? 🥹</h2>
        <p class="desc">Proposed activity: spending quality time together, eating something unnecessarily expensive, and pretending we didn't check the menu prices.</p>
        <div class="buttonzone" id="dateButtons">
          <button class="choice yes" id="dateYes">YES, LET'S GO 💃</button>
          <button class="choice no" id="dateNo">NO. STAY HOME 🧊</button>
        </div>
        <p class="reaction" id="dateReaction"></p>
        <p class="tiny">* Clicking YES may cause one (1) extremely happy Logesh.</p>
      </div>

      <div id="question2" class="hidden">
        <div class="step">Request 02 / 02 · Telecommunications department</div>
        <h2>Can I call Praseetha and Manu? 📞</h2>
        <p class="desc">Just a call. No secret parliament meeting. No suspicious agenda. Probably memes.</p>
        <div class="buttonzone" id="callButtons">
          <button class="choice yes" id="callYes">YES, CALL THEM 📲</button>
          <button class="choice no" id="callNo">NO, PHONE DOWN 🚨</button>
        </div>
        <p class="reaction" id="callReaction"></p>
        <p class="tiny">* The telecom regulator (Spoorthy) has the final say.</p>
      </div>

      <div id="done" class="result hidden">
        <div class="big" id="doneEmoji">📨</div>
        <h2 id="doneTitle">Application submitted!</h2>
        <p id="doneText">The decision has been dispatched to Logesh HQ.</p>
        <p class="tiny" id="emailStatus"></p>
        <button class="reset" id="restart">Review the application ↻</button>
      </div>
    </section>

    <p class="footer">Built with love, questionable confidence, and a suspicious amount of JavaScript.<br>All decisions are final. Appeals may be submitted with snacks. 🍟</p>
  </main>
  <div class="toast" id="toast" role="status"></div>

  <!-- EmailJS sends the completed answers directly from this page. Setup instructions are below the code. -->
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <script>
    /*
      EMAIL SETUP — replace these three values with your EmailJS details.
      1) Create an account at https://www.emailjs.com/
      2) Add an Email Service and an Email Template.
      3) Put the IDs/keys below. Never put a private key here; use only the EmailJS PUBLIC key.
    */
    const EMAILJS_PUBLIC_KEY = "YOUR_EMAILJS_PUBLIC_KEY";
    const EMAILJS_SERVICE_ID = "YOUR_EMAILJS_SERVICE_ID";
    const EMAILJS_TEMPLATE_ID = "YOUR_EMAILJS_TEMPLATE_ID";

    const answers = { date_outing: "", call_praseetha_manu: "" };
    const $ = (id) => document.getElementById(id);
    const funnyDateNo = [
      "The NO button has entered witness protection. Try again. 😭",
      "Objection! The applicant requests reconsideration. ⚖️",
      "That button is experiencing commitment issues. 💨",
      "Logesh.exe has stopped responding. Please reconsider. 🫠"
    ];
    const funnyCallNo = [
      "The phone has been placed under house arrest. 📵",
      "Telecom department says: please reconsider, boss. 🥲",
      "Praseetha and Manu have been put on hold. Literally. ☎️",
      "A tiny violin is playing somewhere. 🎻"
    ];

    function toast(message) {
      $("toast").textContent = message;
      $("toast").classList.add("show");
      clearTimeout(toast.timer);
      toast.timer = setTimeout(() => $("toast").classList.remove("show"), 2500);
    }
    function celebrate() {
      const bits = ["💖","✨","🎉","💐","🪩","🍟"];
      for (let i = 0; i < 28; i++) {
        const el = document.createElement("span");
        el.className = "confetti";
        el.textContent = bits[Math.floor(Math.random() * bits.length)];
        el.style.left = Math.random() * 100 + "vw";
        el.style.animationDuration = (2 + Math.random() * 2.2) + "s";
        el.style.animationDelay = (Math.random() * .45) + "s";
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 5000);
      }
    }
    function showQuestion(number) {
      $("question1").classList.toggle("hidden", number !== 1);
      $("question2").classList.toggle("hidden", number !== 2);
      $("done").classList.add("hidden");
      $("progress").style.width = number === 1 ? "50%" : "100%";
    }
    function moveNoButton(button, container, messages, reaction) {
      // The NO button dodges up to three times, then stays put so every answer remains possible.
      let dodges = 0;
      button.addEventListener("mouseenter", () => {
        if (dodges < 3 && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
          dodges++;
          const maxX = Math.max(0, container.clientWidth - button.offsetWidth);
          const maxY = 28;
          button.style.position = "relative";
          button.style.left = (Math.random() * Math.min(maxX, 120) - 35) + "px";
          button.style.top = (Math.random() * maxY - maxY / 2) + "px";
          reaction.textContent = messages[Math.floor(Math.random() * messages.length)];
        }
      });
      button.addEventListener("click", () => {
        reaction.textContent = messages[Math.floor(Math.random() * messages.length)];
        toast("A bold choice. The committee is taking notes. 📝");
      });
    }

    moveNoButton($("dateNo"), $("dateButtons"), funnyDateNo, $("dateReaction"));
    moveNoButton($("callNo"), $("callButtons"), funnyCallNo, $("callReaction"));

    $("dateYes").addEventListener("click", () => {
      answers.date_outing = "YES — approved";
      celebrate();
      toast("DATE APPROVED! Logesh is doing a victory dance. 🕺");
      setTimeout(() => showQuestion(2), 650);
    });
    $("dateNo").addEventListener("click", () => {
      answers.date_outing = "NO — declined";
      toast("Request declined. Moving to the next agenda item. 🫡");
      setTimeout(() => showQuestion(2), 650);
    });
    $("callYes").addEventListener("click", () => {
      answers.call_praseetha_manu = "YES — approved";
      finish();
    });
    $("callNo").addEventListener("click", () => {
      answers.call_praseetha_manu = "NO — declined";
      finish();
    });

    async function finish() {
      $("question1").classList.add("hidden");
      $("question2").classList.add("hidden");
      $("done").classList.remove("hidden");
      $("progress").style.width = "100%";
      const bothYes = answers.date_outing.startsWith("YES") && answers.call_praseetha_manu.startsWith("YES");
      const bothNo = answers.date_outing.startsWith("NO") && answers.call_praseetha_manu.startsWith("NO");
      $("doneEmoji").textContent = bothYes ? "🪩" : bothNo ? "🫡" : "📨";
      $("doneTitle").textContent = bothYes ? "LOGESH HAS WON THE LOTTERY!" : bothNo ? "APPLICATION DENIED. RESPECTFULLY. 🫡" : "DECISION RECORDED!";
      $("doneText").textContent = bothYes
        ? "Two approvals! Please allow Logesh 3–5 business minutes to stop smiling."
        : bothNo
          ? "A difficult day for the applicant. A great day for boundary-setting."
          : "The committee has spoken. Logesh will now process this information dramatically.";
      $("emailStatus").textContent = "Sending the official decision to Logesh HQ…";
      await sendAnswers();
    }

    async function sendAnswers() {
      const configured = ![EMAILJS_PUBLIC_KEY, EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID]
        .some(v => !v || v.startsWith("YOUR_"));
      if (!configured || !window.emailjs) {
        $("emailStatus").textContent = "Email capture isn't configured yet. Add your EmailJS IDs in this file, then redeploy.";
        return;
      }
      try {
        emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
        await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, {
          respondent: "Spoorthy",
          to_email: "logeshkannanje@gmail.com",
          submitted_at: new Date().toLocaleString(),
          date_outing: answers.date_outing || "Not answered",
          call_praseetha_manu: answers.call_praseetha_manu || "Not answered",
          page_title: "Spoorthy's Permission Portal"
        });
        $("emailStatus").textContent = "Decision successfully emailed to Logesh HQ. The records department is pleased. ✅";
      } catch (error) {
        console.error("EmailJS send failed:", error);
        $("emailStatus").textContent = "The email could not be sent. Please try again or tell Logesh to check the EmailJS setup.";
        toast("Email delivery failed. Please check the EmailJS configuration.");
      }
    }

    $("restart").addEventListener("click", () => {
      answers.date_outing = "";
      answers.call_praseetha_manu = "";
      $("dateNo").style.left = $("dateNo").style.top = "";
      $("callNo").style.left = $("callNo").style.top = "";
      $("dateReaction").textContent = "";
      $("callReaction").textContent = "";
      showQuestion(1);
    });
  </script>
</body>
</html>
